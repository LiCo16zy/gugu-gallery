{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuguGallery",
  "version": "0.7.0",
  "identifier": "com.gugu.gallery",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "咕咕图库",
        "width": 1480,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 660,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' gugu: http://gugu.localhost asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "WebView2Loader.dll": "WebView2Loader.dll"
    },
    "publisher": "LiCo16zy",
    "shortDescription": "咕咕图库 · 桌面爬虫与本地图库浏览器",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
