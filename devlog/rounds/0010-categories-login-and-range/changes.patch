+}
+.date-menu input[type='date']:hover {
+  border-color: var(--border-strong);
+}
+.date-menu input[type='date']:focus {
+  outline: none;
+  border-color: var(--accent);
+}
+.date-menu .date-actions {
+  display: flex;
+  justify-content: flex-end;
+  margin-top: 2px;
+}
+.date-menu .dim {
+  margin: 8px 0 0;
+  font-size: 11px;
+  line-height: 1.6;
+}
+
 .pill {
   display: inline-flex;
   align-items: center;
