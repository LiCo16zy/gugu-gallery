+/* ============================================================================
+   页面标注工具 · 样式
+   刻意用一套独立的暖色调，和应用的冷色主题区分开，避免误判当前处于哪种模式。
+   ========================================================================== */
+
+.gugu-anno-root {
+  --anno: #ff9f45;
+  --anno-soft: rgba(255, 159, 69, 0.16);
+  --anno-line: rgba(255, 159, 69, 0.85);
+  --anno-panel: #16130f;
+  --anno-panel-2: #1e1a15;
+  --anno-border: rgba(255, 178, 102, 0.22);
+  --anno-text: #f4ece2;
+  --anno-dim: #a99a89;
+
+  position: fixed;
+  inset: 0;
+  z-index: 9999;
+  pointer-events: none;
+  font-family: var(--font);
+  font-size: 12.5px;
+  color: var(--anno-text);
+}
+
+.gugu-anno-root * {
+  box-sizing: border-box;
+}
+
+/* ------------------------------------------------------------------ 工具栏 */
+
+.gugu-anno-toolbar {
+  position: absolute;
+  top: 12px;
+  left: 50%;
+  transform: translateX(-50%);
+  pointer-events: auto;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  padding: 7px 9px;
+  border-radius: 13px;
+  background: color-mix(in srgb, var(--anno-panel) 94%, transparent);
+  border: 1px solid var(--anno-border);
+  box-shadow: 0 18px 44px -14px rgba(0, 0, 0, 0.8);
+  backdrop-filter: blur(14px);
+}
+
+.gugu-anno-brand {
+  display: flex;
+  align-items: baseline;
+  gap: 7px;
+  padding: 0 6px 0 3px;
+  border-right: 1px solid var(--anno-border);
+}
+.gugu-anno-brand b {
+  color: var(--anno);
+  font-weight: 650;
+  letter-spacing: 0.2px;
+}
+.gugu-anno-brand em {
+  font-style: normal;
+  color: var(--anno-dim);
+  font-variant-numeric: tabular-nums;
+}
+
+.gugu-anno-seg {
+  display: flex;
+  gap: 2px;
+  padding: 3px;
+  border-radius: 9px;
+  background: rgba(0, 0, 0, 0.35);
+}
+.gugu-anno-seg button {
+  border: none;
+  background: transparent;
+  color: var(--anno-dim);
+  padding: 4px 11px;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: all 0.14s var(--ease);
+}
+.gugu-anno-seg button:hover {
+  color: var(--anno-text);
+}
+.gugu-anno-seg button.on {
+  background: var(--anno);
+  color: #241704;
+  font-weight: 600;
+}
+
+.gugu-anno-btn {
+  border: 1px solid var(--anno-border);
+  background: rgba(255, 255, 255, 0.04);
+  color: var(--anno-text);
+  padding: 6px 12px;
+  border-radius: 8px;
+  cursor: pointer;
+  transition: all 0.14s var(--ease);
+  white-space: nowrap;
+}
+.gugu-anno-btn:hover:not(:disabled) {
+  background: rgba(255, 255, 255, 0.1);
+}
+.gugu-anno-btn:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+.gugu-anno-btn.on {
+  background: var(--anno-soft);
+  border-color: var(--anno-line);
+  color: var(--anno);
+}
+.gugu-anno-btn.primary {
+  background: linear-gradient(135deg, #ffb35c, #ff8a2b);
+  border-color: transparent;
+  color: #241704;
+  font-weight: 600;
+}
+.gugu-anno-btn.primary:hover:not(:disabled) {
+  filter: brightness(1.08);
+}
+.gugu-anno-btn.danger {
+  color: #ff9b8a;
+  border-color: rgba(255, 120, 100, 0.3);
+}
+
+.gugu-anno-hint {
+  position: absolute;
+  top: 66px;
+  left: 50%;
+  transform: translateX(-50%);
+  pointer-events: none;
+  padding: 5px 13px;
+  border-radius: 99px;
+  background: color-mix(in srgb, var(--anno-panel) 88%, transparent);
+  border: 1px solid var(--anno-border);
+  color: var(--anno-dim);
+  font-size: 11.5px;
+  white-space: nowrap;
+}
+
+/* ------------------------------------------------------------------ 高亮 */
+
+.gugu-anno-hover {
+  position: absolute;
+  pointer-events: none;
+  outline: 2px solid var(--anno-line);
+  outline-offset: 1px;
+  background: var(--anno-soft);
+  border-radius: 3px;
+}
+
+.gugu-anno-hover-label {
+  position: absolute;
+  top: -23px;
+  left: -2px;
+  padding: 2px 8px;
+  border-radius: 5px;
+  background: var(--anno);
+  color: #241704;
+  font-size: 11px;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.gugu-anno-drag {
+  position: absolute;
+  pointer-events: none;
+  border: 2px dashed var(--anno);
+  background: var(--anno-soft);
+  border-radius: 4px;
+}
+
+/* ------------------------------------------------------------------ 图钉 */
+
+.gugu-anno-pin {
+  position: absolute;
+  pointer-events: auto;
+  cursor: pointer;
+  border: 2px solid var(--anno);
+  border-radius: 5px;
+  background: var(--anno-soft);
+  transition: box-shadow 0.15s var(--ease);
+}
+.gugu-anno-pin:hover {
+  box-shadow: 0 0 0 3px rgba(255, 159, 69, 0.28);
+}
+
+.gugu-anno-pin.gugu-anno-layout {
+  border-color: #6fd3ff;
+  background: rgba(111, 211, 255, 0.14);
+}
+.gugu-anno-pin.gugu-anno-content {
+  border-color: #b39bff;
+  background: rgba(179, 155, 255, 0.14);
+}
+.gugu-anno-pin.gugu-anno-behavior {
+  border-color: #6ee7a8;
+  background: rgba(110, 231, 168, 0.14);
+}
+.gugu-anno-pin.gugu-anno-bug {
+  border-color: #ff7676;
+  background: rgba(255, 118, 118, 0.16);
+}
+.gugu-anno-pin.gugu-anno-other {
+  border-color: #b9bec9;
+  background: rgba(185, 190, 201, 0.14);
+}
+
+.gugu-anno-index {
+  position: absolute;
+  top: -11px;
+  left: -11px;
+  width: 21px;
+  height: 21px;
+  border-radius: 50%;
+  background: var(--anno);
+  color: #241704;
+  font-size: 11px;
+  font-weight: 700;
+  display: grid;
+  place-items: center;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
+}
+.gugu-anno-pin.gugu-anno-layout .gugu-anno-index {
+  background: #6fd3ff;
+}
+.gugu-anno-pin.gugu-anno-content .gugu-anno-index {
+  background: #b39bff;
+}
+.gugu-anno-pin.gugu-anno-behavior .gugu-anno-index {
+  background: #6ee7a8;
+}
+.gugu-anno-pin.gugu-anno-bug .gugu-anno-index {
+  background: #ff7676;
+}
+.gugu-anno-pin.gugu-anno-other .gugu-anno-index {
+  background: #b9bec9;
+}
+
+/* ------------------------------------------------------------------ 编辑框 */
+
+.gugu-anno-editor {
+  position: absolute;
+  pointer-events: auto;
+  width: 360px;
+  padding: 13px 14px 11px;
+  border-radius: 13px;
+  background: var(--anno-panel);
+  border: 1px solid var(--anno-border);
+  box-shadow: 0 22px 50px -16px rgba(0, 0, 0, 0.85);
+}
+
+.gugu-anno-editor-head {
+  display: flex;
