{
  "name": "gugu-gallery",
  "version": "0.7.0",
  "private": true,
  "description": "咕咕小站图片爬虫 + 本地图库浏览器（Tauri 2 桌面应用）",
  "author": "LiCo16zy",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/demo.mjs",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build:web": "vite build --config vite.renderer.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "npm run typecheck && tauri build --no-bundle",
    "crawl": "node scripts/crawl.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node scripts/shot.mjs",
    "uicheck": "node scripts/uicheck.mjs",
    "pausecheck": "node scripts/check-pause.mjs",
    "e2e": "node scripts/e2e.mjs",
    "annotatecheck": "node plugins/annotator/bin/check.mjs",
    "round": "node plugins/devlog/bin/round.mjs",
    "pack": "node scripts/release.mjs build",
    "dist": "node scripts/release.mjs dist"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
